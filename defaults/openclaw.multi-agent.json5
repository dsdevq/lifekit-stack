// openclaw.multi-agent.json5 — v2 modular-monolith config target.
//
// ⚠ DO NOT MERGE THIS INTO /srv/openclaw/config/openclaw.json YET.
//
// v2 is migrated as ONE cutover, not piecemeal. This file accumulates the
// target shape as agents come online (orchestrator + workspace today; health,
// finance, dev added as built). VPS deploy happens only when the full v2
// stack — including DevClaw v2 MCP, all planned domain agents, and their
// workspaces — is ready end-to-end. Until then v1 keeps running undisturbed.
//
// This is the v2 shape: ONE orchestrator agent receives every inbound
// message; domain agents are dispatched via `agentToAgent`. MCP servers
// (devclaw, google-workspace) are registered as tools but are NOT agents —
// see docs/openclaw-agent-design.md "Boundary rules" for when to use which.
//
// When ready to cut over (full v2 complete):
//   1. Read existing /srv/openclaw/config/openclaw.json on the VPS.
//   2. Merge the agents / bindings / tools / mcp blocks below into it
//      (preserving gateway / channels / auth / plugins from existing file).
//   3. Create per-agent workspace dirs and copy AGENTS.md from defaults/agents/
//      into each (e.g. /srv/openclaw/agents/<id>/workspace/AGENTS.md).
//   4. docker compose -f compose/docker-compose.yml --env-file ... \
//        up -d --force-recreate openclaw-gateway
//   5. Retire the v1 markdown-skill stack in the same cutover.
//
// Invariant: bindings always point inbound channels at the orchestrator.
// Domain agents are reached only via agentToAgent, never bound to channels.

{
  agents: {
    defaults: {
      // Per-agent model selection lives on each agent below (see
      // [[model-tier-per-subagent]] — Haiku for simple, Sonnet for default,
      // Opus reserved). Keep `defaults.model` unset so missing tier = error.
      agentRuntime: { id: "claude-cli" },
    },

    list: [
      {
        id: "orchestrator",
        default: true,
        name: "Kit",
        // Workspace is bind-mounted from the host. Container side mirrors
        // /srv/openclaw/agents/orchestrator/workspace.
        workspace: "/home/node/.openclaw/agents/orchestrator/workspace",
        agentDir: "/home/node/.openclaw/agents/orchestrator/agent",

        // Sonnet for routing + synthesis. Escalate to Opus only for hard
        // cross-domain reasoning if it shows up in practice.
        model: "anthropic/claude-sonnet-4-6",
      },

      {
        id: "workspace",
        name: "Workspace",
        workspace: "/home/node/.openclaw/agents/workspace/workspace",
        agentDir: "/home/node/.openclaw/agents/workspace/agent",

        // Haiku: workspace agent is mostly tool orchestration over the
        // google-workspace MCP. Reasoning load is light.
        model: "anthropic/claude-haiku-4-5",
      },
    ],
  },

  // Single binding: every Telegram message lands at the orchestrator.
  // Add per-channel bindings here as new channels come online — all to
  // `orchestrator`. Domain agents are NEVER bound to channels directly.
  bindings: [
    {
      agentId: "orchestrator",
      match: { channel: "telegram", accountId: "*" },
    },
  ],

  // Enable agent-to-agent calls. Allowlist is which agents may SEND messages
  // to others (not which may be received) — orchestrator is the only sender
  // in the modular-monolith pattern.
  tools: {
    agentToAgent: {
      enabled: true,
      allow: ["orchestrator"],
    },
  },

  // MCP servers registered with the gateway. Each domain agent's AGENTS.md
  // documents which of these it should call. See defaults/modules.yaml for
  // the human-readable routing manifest the lifekit-router skill consumes.
  mcp: {
    servers: [
      // devclaw-mcp — dev work, async (multi-hour autonomous coding runs).
      // Reached only by the future `dev` agent. NOT yet wired in this slice.
      // {
      //   id: "devclaw",
      //   transport: "streamable-http",
      //   url: "http://devclaw-mcp:8000/mcp/",
      // },

      // google-workspace — Gmail/Calendar/Docs/Sheets/Drive/Tasks.
      // Reached by the `workspace` agent.
      {
        id: "google-workspace",
        transport: "streamable-http",
        url: "http://google-workspace-mcp:8000/mcp/",
      },
    ],
  },

  // gateway, channels, auth, plugins — preserve from existing openclaw.json.
  // Only the four blocks above (agents / bindings / tools / mcp) change in
  // this slice.
}
