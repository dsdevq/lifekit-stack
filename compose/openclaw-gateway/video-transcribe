#!/bin/bash
# Summarizes an inbound video for OpenClaw's tools.media.video CLI fallback.
#
# Two channels, both best-effort:
#   1. Audio   — ffmpeg strips the audio track → whisper transcribes
#   2. Visual  — ffmpeg extracts 3 evenly-spaced keyframes →
#                `openclaw infer image describe-many` routes them through
#                the configured image provider (Anthropic Claude here).
#
# Visual side uses OpenClaw's first-party CLI rather than shelling out to
# claude directly, so auth/provider/transport stays consistent with the
# inbound-photo pipeline. The output is the two labelled sections OpenClaw
# expects on stdout.
#
# Why this exists: Claude isn't in OpenClaw's video provider matrix
# (Google/Qwen/Moonshot only). Decomposing video into audio+keyframes
# stays on the Pro subscription with no extra API keys.

set -uo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: video-transcribe <media-path>" >&2
  exit 64
fi

INPUT="$1"
SCRATCH=$(mktemp -d)
trap 'rm -rf "$SCRATCH"' EXIT

# ── audio ────────────────────────────────────────────────────────────────
WAV="$SCRATCH/audio.wav"
TRANSCRIPT=""
if ffmpeg -hide_banner -loglevel error -y -i "$INPUT" -vn -ar 16000 -ac 1 -f wav "$WAV" 2>/dev/null && [[ -s "$WAV" ]]; then
  if /opt/whisper/bin/whisper \
      --model base \
      --output_format txt \
      --output_dir "$SCRATCH" \
      --language en \
      "$WAV" >/dev/null 2>&1 \
      && [[ -f "$SCRATCH/audio.txt" ]]; then
    TRANSCRIPT=$(tr -s '[:space:]' ' ' < "$SCRATCH/audio.txt" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  fi
fi

# ── visual ───────────────────────────────────────────────────────────────
DUR=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$INPUT" 2>/dev/null | head -1)
DUR=${DUR:-3}
FRAME_ARGS=()
COUNT=0
for pct in 0.10 0.50 0.90; do
  COUNT=$((COUNT + 1))
  t=$(awk "BEGIN {printf \"%.2f\", $DUR * $pct}")
  out="$SCRATCH/frame_${COUNT}.jpg"
  if ffmpeg -hide_banner -loglevel error -y -ss "$t" -i "$INPUT" -vframes 1 -vf scale=512:-1 -q:v 4 "$out" 2>/dev/null && [[ -s "$out" ]]; then
    FRAME_ARGS+=(--file "$out")
  fi
done

DESCRIPTION=""
if (( ${#FRAME_ARGS[@]} > 0 )); then
  JSON=$(timeout 120 node /app/dist/index.js infer image describe-many "${FRAME_ARGS[@]}" --json 2>/dev/null) || JSON=""
  if [[ -n "$JSON" ]]; then
    DESCRIPTION=$(python3 - "$JSON" <<'PY' 2>/dev/null
import json, sys
try:
    d = json.loads(sys.argv[1])
    parts = []
    for i, o in enumerate(d.get("outputs", []), 1):
        txt = (o.get("text") or "").strip()
        if txt:
            parts.append(f"Frame {i}: {txt}")
    print("\n".join(parts))
except Exception:
    pass
PY
)
  fi
fi

# ── stitch ───────────────────────────────────────────────────────────────
echo "[Audio]"
echo "${TRANSCRIPT:-<no speech>}"
echo
echo "[Visual]"
echo "${DESCRIPTION:-<no description>}"
