#!/bin/bash
# Extracts the audio track from a video with ffmpeg and transcribes it with
# whisper. Emits the transcript on stdout, in the shape OpenClaw's
# tools.media.video CLI-entry contract expects.
#
# Video understanding via Claude Pro isn't supported (the matrix is
# Google/Qwen/Moonshot only), and Denys's actual Telegram video usage is
# talking-on-camera while doing things — so audio-only transcription
# recovers ~all of the signal without paid APIs.

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: video-transcribe <media-path>" >&2
  exit 64
fi

INPUT="$1"
WAV="$(mktemp --suffix=.wav)"
WHISPER_OUT_DIR="$(mktemp -d)"
trap 'rm -rf "$WAV" "$WHISPER_OUT_DIR"' EXIT

ffmpeg -hide_banner -loglevel error -y -i "$INPUT" -vn -ar 16000 -ac 1 -f wav "$WAV"

/opt/whisper/bin/whisper \
  --model base \
  --output_format txt \
  --output_dir "$WHISPER_OUT_DIR" \
  --language en \
  "$WAV" >/dev/null 2>&1

cat "$WHISPER_OUT_DIR/$(basename "$WAV" .wav).txt"
