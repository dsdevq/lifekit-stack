[Unit]
# ops-agent — bare-metal deploy unit.
#
# NOT the primary path on the reference deployment (which runs ops-agent
# inside docker-compose alongside devclaw-mcp). This unit exists for
# operators who run the ops-agent directly on the host — e.g. during
# calibration of a new detector before it ships in the container image.
#
# See ops-agent/README.md for the full deploy story.
Description=ops-agent — devclaw incident detector (ops-PR1 baseline)
Documentation=https://github.com/dsdevq/lifekit-stack/tree/main/ops-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Match the lifekit-stack convention: the lifekit user owns /srv/* and
# /var/lib/lifekit. Adjust if your host uses a different service account.
User=lifekit
Group=lifekit
Environment=OPS_AGENT_GOALS_DIR=/srv/devclaw/goals
Environment=OPS_AGENT_INCIDENTS_DIR=/srv/memory/projects/ops-agent/incidents
Environment=OPS_AGENT_POLL_INTERVAL_S=60
Environment=OPS_AGENT_DEDUP_WINDOW_S=86400
ExecStart=/usr/local/bin/ops-agent
Restart=on-failure
RestartSec=10s
# Stop the same way compose does — give the process a chance to drain
# the current tick.
TimeoutStopSec=30s

# Hardening: minimal capabilities, no new privs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/memory/projects/ops-agent
PrivateTmp=true
PrivateDevices=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
